# Ollama Configuration
# For cloud-hosted Ollama, use your cloud URL (e.g., https://ollama.yourdomain.com)
# For local development, use: http://localhost:11434
OLLAMA_URL=https://your-cloud-ollama-instance.com
OLLAMA_MODEL=gemma3:4b

# Server Configuration
PORT=8000

# Optional: API key if your cloud Ollama is behind authentication
# OLLAMA_API_KEY=your_api_key_here
