# Ollama Configuration
# Set this to your actual Ollama API endpoint (the server running ollama serve).
# This is NOT https://ollama.com (that is the marketing website).
# Examples:
#   - Self-hosted:      http://your-server-ip:11434
#   - Cloud instance:   https://ollama.yourdomain.com
#   - Railway private:  http://ollama.railway.internal:11434
#   - Local dev:        http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434

# Model to use for OCR
OLLAMA_MODEL=gemma3:4b

# Server Configuration
PORT=8000

# Optional: API key if your Ollama instance requires authentication
# OLLAMA_API_KEY=your_api_key_here
